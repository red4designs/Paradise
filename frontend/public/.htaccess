# Force HTTPS and canonical URL redirects
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Force HTTPS - redirect all HTTP traffic to HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Force non-www - redirect www to non-www for canonical URL
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [L,R=301]
    
    # Ensure canonical domain (redirect any other domains to paradisevattavada.com)
    RewriteCond %{HTTP_HOST} !^paradisevattavada\.com$ [NC]
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteRule ^(.*)$ https://paradisevattavada.com%{REQUEST_URI} [L,R=301]
</IfModule>

# Cache static assets for better performance
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - cache for 1 year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    
    # CSS and JavaScript - cache for 1 year (with versioning)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Fonts - cache for 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    
    # Media files - cache for 6 months
    ExpiresByType video/mp4 "access plus 6 months"
    ExpiresByType video/webm "access plus 6 months"
    ExpiresByType audio/mp3 "access plus 6 months"
    ExpiresByType audio/wav "access plus 6 months"
    
    # Documents - cache for 1 month
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/json "access plus 1 week"
    ExpiresByType application/xml "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
    
    # HTML - cache for 1 hour
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Enable enhanced compression for better performance
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE application/font-woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    
    # Set compression level (1-9, 9 is highest)
    DeflateCompressionLevel 9
    
    # Don't compress already compressed files
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \.(?:exe|t?gz|zip|bz2|sit|rar|7z)$ no-gzip dont-vary
</IfModule>

# Add cache-control headers with enhanced mobile optimization
<IfModule mod_headers.c>
    # Enhanced mobile-optimized cache headers - maximum caching for mobile devices
    <If "%{HTTP_USER_AGENT} =~ /Mobile|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i">
        # Cache static assets with maximum TTL for mobile (save bandwidth)
        <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|otf)$">
            Header set Cache-Control "public, max-age=94608000, immutable, stale-while-revalidate=86400"
            Header set Vary "Accept-Encoding"
            Header set Pragma "public"
        </FilesMatch>
        
        # Cache media files with extended lifetime on mobile
        <FilesMatch "\.(mp4|webm|mp3|wav|pdf)$">
            Header set Cache-Control "public, max-age=47304000, stale-while-revalidate=86400"
            Header set Vary "Accept-Encoding"
            Header set Pragma "public"
        </FilesMatch>
        
        # Cache JSON/XML with longer TTL on mobile
        <FilesMatch "\.(json|xml)$">
            Header set Cache-Control "public, max-age=2419200, stale-while-revalidate=3600"
            Header set Vary "Accept-Encoding"
            Header set Pragma "public"
        </FilesMatch>
    </If>
    
    # Enhanced desktop cache headers with longer lifetimes
    <If "%{HTTP_USER_AGENT} !~ /Mobile|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i">
        # Cache static assets with extended immutable flag for better performance
        <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|otf)$">
            Header set Cache-Control "public, max-age=63072000, immutable, stale-while-revalidate=86400"
            Header set Vary "Accept-Encoding"
            Header set Pragma "public"
        </FilesMatch>
    
        # Cache media files with extended lifetime
        <FilesMatch "\.(mp4|webm|mp3|wav|pdf)$">
            Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
            Header set Vary "Accept-Encoding"
            Header set Pragma "public"
        </FilesMatch>
        
        # Cache JSON and XML files with longer TTL
        <FilesMatch "\.(json|xml)$">
            Header set Cache-Control "public, max-age=1209600, stale-while-revalidate=3600"
            Header set Vary "Accept-Encoding"
            Header set Pragma "public"
        </FilesMatch>
    </If>
    
    # Cache HTML for shorter time with revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
        Header set Vary "Accept-Encoding"
        Header set Pragma "public"
    </FilesMatch>
    
    # Cache service worker and web worker files with shorter TTL for updates
    <FilesMatch "\.(sw\.js|worker\.js)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
        Header set Vary "Accept-Encoding"
        Header set Pragma "public"
    </FilesMatch>
    
    # Cache manifest and sitemap files
    <FilesMatch "\.(manifest|webmanifest|sitemap\.xml|robots\.txt)$">
        Header set Cache-Control "public, max-age=604800, must-revalidate"
        Header set Vary "Accept-Encoding"
        Header set Pragma "public"
    </FilesMatch>
    
    # Add performance and resource hints
    <FilesMatch "\.(html|htm)$">
        Header add Link "</paradise-logo.svg>; rel=preload; as=image"
        Header add Link "</static/css/main.css>; rel=preload; as=style"
        Header add Link "</static/js/main.js>; rel=preload; as=script"
        Header add Link "<https://fonts.gstatic.com>; rel=preconnect; crossorigin"
        Header add Link "<https://www.googletagmanager.com>; rel=dns-prefetch"
    </FilesMatch>
    
    # Add comprehensive security headers for Trust and Safety
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HTTP Strict Transport Security (HSTS) - Force HTTPS for 2 years
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
    
    # Cross-Origin Opener Policy (COOP) for origin isolation
    Header always set Cross-Origin-Opener-Policy "same-origin"
    
    # Cross-Origin Embedder Policy (COEP) for additional isolation
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    
    # Cross-Origin Resource Policy (CORP) 
    Header always set Cross-Origin-Resource-Policy "same-origin"
    
    # Content Security Policy (CSP) - Development-friendly configuration
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com https://connect.facebook.net https://maps.googleapis.com https://apis.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://maps.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; media-src 'self' data: blob:; object-src 'none'; frame-src 'self' https://www.google.com https://maps.google.com https://www.facebook.com; connect-src 'self' https://www.google-analytics.com https://ssl.google-analytics.com https://maps.googleapis.com https://api.github.com ws://localhost:* http://localhost:*; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; worker-src 'self' blob:"
    
    # Permissions Policy (formerly Feature Policy) - Control browser features
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), speaker=(self), vibrate=(self), fullscreen=(self)"
    
    # X-Permitted-Cross-Domain-Policies - Restrict cross-domain access
    Header always set X-Permitted-Cross-Domain-Policies "none"
    
    # Add performance headers
    Header always set Accept-CH "DPR, Viewport-Width, Width"
    Header always set Critical-CH "DPR, Viewport-Width, Width"
</IfModule>

# Enable ETags for better caching
<IfModule mod_headers.c>
    Header unset ETag
    FileETag None
</IfModule>

# Handle React Router (client-side routing)
<IfModule mod_rewrite.c>
    # RewriteEngine is already enabled above
    
    # Handle Angular and React Router
    # If the requested resource doesn't exist as a file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    
    # Serve index.html for all routes (except API calls and static files)
    RewriteRule ^(?!api/).*$ /index.html [L,QSA]
</IfModule>