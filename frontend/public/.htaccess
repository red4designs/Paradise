# Cache static assets for better performance
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images - cache for 1 year
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    
    # CSS and JavaScript - cache for 1 year (with versioning)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Fonts - cache for 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    
    # Media files - cache for 6 months
    ExpiresByType video/mp4 "access plus 6 months"
    ExpiresByType video/webm "access plus 6 months"
    ExpiresByType audio/mp3 "access plus 6 months"
    ExpiresByType audio/wav "access plus 6 months"
    
    # Documents - cache for 1 month
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/json "access plus 1 week"
    ExpiresByType application/xml "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
    
    # HTML - cache for 1 hour
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Add cache-control headers with mobile optimization
<IfModule mod_headers.c>
    # Mobile-optimized cache headers - more aggressive caching for mobile devices
    <If "%{HTTP_USER_AGENT} =~ /Mobile|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i">
        # Cache static assets with longer TTL for mobile (save bandwidth)
        <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|otf)$">
            Header set Cache-Control "public, max-age=63072000, immutable, stale-while-revalidate=86400"
            Header set Vary "Accept-Encoding"
        </FilesMatch>
        
        # Cache media files longer on mobile
        <FilesMatch "\.(mp4|webm|mp3|wav|pdf)$">
            Header set Cache-Control "public, max-age=31536000, stale-while-revalidate=86400"
            Header set Vary "Accept-Encoding"
        </FilesMatch>
        
        # Cache JSON/XML longer on mobile
        <FilesMatch "\.(json|xml)$">
            Header set Cache-Control "public, max-age=1209600, stale-while-revalidate=3600"
            Header set Vary "Accept-Encoding"
        </FilesMatch>
    </If>
    
    # Desktop cache headers (existing behavior)
    <If "%{HTTP_USER_AGENT} !~ /Mobile|Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i">
        # Cache static assets with immutable flag for better performance
        <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|otf)$">
            Header set Cache-Control "public, max-age=31536000, immutable"
            Header set Vary "Accept-Encoding"
        </FilesMatch>
    
        # Cache media files
        <FilesMatch "\.(mp4|webm|mp3|wav|pdf)$">
            Header set Cache-Control "public, max-age=15552000"
            Header set Vary "Accept-Encoding"
        </FilesMatch>
        
        # Cache JSON and XML files
        <FilesMatch "\.(json|xml)$">
            Header set Cache-Control "public, max-age=604800"
            Header set Vary "Accept-Encoding"
        </FilesMatch>
    </If>
    
    # Cache HTML for shorter time with revalidation
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
        Header set Vary "Accept-Encoding"
    </FilesMatch>
    
    # Add security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable ETags for better caching
<IfModule mod_headers.c>
    Header unset ETag
    FileETag None
</IfModule>